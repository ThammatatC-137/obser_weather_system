
# MongoDB Atlas connection string
# สร้าง cluster ที่ https://cloud.mongodb.com แล้วกด Connect > Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appname>

# Gemini API Key (AI หลัก)
# สร้างได้ที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Groq API Key (AI สำรอง fallback เมื่อ Gemini ไม่ว่าง)
# สร้างได้ที่ https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Geoapify API Key (สำหรับ geocoding ในหน้า "หาที่ดูดาว")
# สร้างได้ที่ https://www.geoapify.com/
NEXT_PUBLIC_GEOAPIFY_KEY=...
